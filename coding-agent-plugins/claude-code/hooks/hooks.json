{
  "description": "The Bash guard that points at glab-pipeline and glab-discussion, and a session check of the glab-cli-extras install",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-cc-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-glab-cli-extras.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
